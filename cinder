#!/usr/bin/env python3
import os
import sys
from pathlib import Path

# Re-exec under the project venv so `./cinder` works without activating it.
_venv = Path(__file__).resolve().parent / ".venv"
_python = _venv / "bin" / "python3"
if _python.exists() and Path(sys.prefix).resolve() != _venv.resolve():
    os.execv(str(_python), [str(_python), __file__, *sys.argv[1:]])

from cinders.cli import main

if __name__ == "__main__":
    main()
